# Clipper needs no secrets and reads no .env at runtime — it's stdlib-only and
# every lever lives in the CONFIG block at the top of clipper.py. This file just
# writes those defaults out in one place so you can see them without opening the
# script, and copy the numbers you want to change.
#
# To actually change a value: edit CONFIG in clipper.py. lead-in and tail can
# also be overridden per-run with --lead-in / --tail.

# --- padding (seconds) -----------------------------------------------------
# How much run-up and reaction to wrap around each detected moment.
LEAD_IN_SECONDS=6
TAIL_SECONDS=8

# --- scoring ---------------------------------------------------------------
# Base score per signal. /tmark notes win, then laughter, then auto-events.
SCORE_NOTE=100
SCORE_LAUGHTER=55
SCORE_EVENT=35            # default game-event, before the per-kind overrides

# Per-event-kind scores (the bit before ':' in a telemetry mark).
EVENT_SCORE_CHASE=50      # a whole chase round ending
EVENT_SCORE_MOMENT=45     # a scripted set-piece disaster
EVENT_SCORE_BRUTE_WAVE=42 # the every-fifth boss cadence
EVENT_SCORE_WAVE_CLEARED=30

# A voice burst on top of another candidate = the room reacting to it. Merged
# in, and the candidate earns this on top.
REACTION_BOOST=25

# --- laughter detection ----------------------------------------------------
# Utterances closer together than this cluster into one burst.
LAUGHTER_GAP_SECONDS=8
# A burst counts as a reaction with this many distinct voices OR this many
# utterances — whichever it hits first.
LAUGHTER_MIN_SPEAKERS=2
LAUGHTER_MIN_UTTERANCES=3

# --- misc ------------------------------------------------------------------
# Padded windows within this gap are treated as one moment and merged.
MERGE_GAP_SECONDS=3
# Max characters of transcript to hang on a candidate as a caption.
CAPTION_MAX_CHARS=120
