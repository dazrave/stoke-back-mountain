# Copy to .env and fill in. .env is git-ignored.

# Discord bot token: https://discord.com/developers/applications
#   New Application -> Bot -> Reset Token -> copy
# The bot needs no privileged intents. Invite it with the "Connect" permission.
DISCORD_TOKEN=

# Right-click your server -> Copy Server ID  (needs Developer Mode on)
GUILD_ID=

# Right-click the voice channel you play in -> Copy Channel ID
VOICE_CHANNEL_ID=

# --- optional tuning -------------------------------------------------------

# tiny.en is quicker and dafter; medium.en is slower and better. small.en is
# the sweet spot for a room full of blokes shouting over each other.
EARSHOT_MODEL=small.en

# cpu keeps the GPU free for the game. Use cuda if you're transcribing from a
# machine that isn't also running GTA.
EARSHOT_DEVICE=cpu
EARSHOT_COMPUTE=int8

# Ignore anything shorter than this - coughs, door slams, desk knocks.
MIN_UTTERANCE_MS=700

# How long a pause counts as "finished talking".
SILENCE_MS=900
